{
  "name": "@nextlevelbuilder/contracts",
  "version": "0.2.1",
  "description": "Zod schemas, block definitions, layout templates, canonical hasher, and API contracts for Next Level Builders Directory",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"try { fs.rmSync('dist', { recursive: true, force: true }); } catch {}\""
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextlevelbuilder/nlb-directory-toolkits.git",
    "directory": "packages/contracts"
  },
  "license": "MIT",
  "files": [
    "dist"
  ]
}
